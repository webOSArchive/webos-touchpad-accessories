#!/bin/sh
# postinst -- install the Bluetooth gamepad stack on-device.
# Runs as root under ipkg/Preware. Idempotent and reversible (see prerm).
# NOTE: does NOT reboot -- the reboot is declared in the package control's
# Source JSON (PostInstallFlags:RestartDevice) so Preware can stack reboots.
#
# 1.2.0 is the TouchPad Go (opal) build. It differs from 1.1.0 in ONE place:
# how the gamepad is exposed inside the PDK app jail (step 3). Everything else
# is unchanged. On any machine that is not opal it deliberately leaves
# /etc/jail_pdk.conf exactly as it found it.
PID="org.webosarchive.btgamepad"
[ -z "$IPKG_OFFLINE_ROOT" ] && IPKG_OFFLINE_ROOT=/media/cryptofs/apps
mount -o remount,rw / 2>/dev/null || true

# locate our payload (offline-root aware, like other feed packages)
SRC=""
for R in "$IPKG_OFFLINE_ROOT" /media/cryptofs/apps /var ""; do
    [ -f "$R/usr/palm/applications/$PID/files/libpmbtgamepad.so" ] && { SRC="$R/usr/palm/applications/$PID/files"; break; }
done
[ -n "$SRC" ] || { echo "ERROR: btgamepad payload not found"; exit 1; }

# 1. the shim
cp -f "$SRC/libpmbtgamepad.so" /usr/lib/libpmbtgamepad.so
chmod 644 /usr/lib/libpmbtgamepad.so

# 2. udev rule: make the gamepad node 0666 so unjailed apps can read it
cp -f "$SRC/99-bt-gamepad.rules" /etc/udev/rules.d/99-bt-gamepad.rules
chmod 644 /etc/udev/rules.d/99-bt-gamepad.rules
/sbin/udevcontrol reload_rules 2>/dev/null || true

# 3. expose the gamepad inside the PDK app jail.
#
#    1.1.0 did this with "mount ro /dev/input", which is a genuine bind mount of
#    the host's /dev/input into the jail. On the Go that blacks out PDK games
#    (see docs/PDK-GRAPHICS-REGRESSION.md), and while it is mounted anything
#    that deletes the jail directory deletes the device's real input nodes.
#
#    1.2.0 uses jailer's mknod verb instead: the event nodes are created inside
#    the jail, no mount is involved, and the host is never referenced.
JPK=/etc/jail_pdk.conf
JPKORIG=$JPK.btshim-orig
MACHINE=$(cat /etc/prefs/properties/machineName 2>/dev/null)

# 3a. Drop any live 1.1.0 bind mount, on every machine. This is pure hazard
#     removal, not a config change: while one of these is mounted, an app
#     uninstall or a stray rm -rf of the jail wipes /dev/input on the host.
grep " /var/palm/jail/[^ ]*/dev/input " /proc/mounts 2>/dev/null | cut -d' ' -f2 | while read -r M; do
    umount "$M" 2>/dev/null && echo "btgamepad: unmounted stale jail bind mount $M"
done

# 3b. Repair input nodes a 1.1.0 jail teardown already deleted. No-op on a
#     healthy device. (A reboot repairs this too, via udev coldplug, but the
#     buttons should not stay dead between installing and rebooting.)
if [ -d /dev/input ]; then
    chown 0:0 /dev/input 2>/dev/null || true
    chmod 755 /dev/input 2>/dev/null || true
    for D in /sys/class/input/event*; do
        [ -f "$D/dev" ] || continue
        N=${D##*/}
        [ -e "/dev/input/$N" ] && continue
        MAJ=$(cut -d: -f1 "$D/dev"); MIN=$(cut -d: -f2 "$D/dev")
        mknod "/dev/input/$N" c "$MAJ" "$MIN" 2>/dev/null && \
            chown 0:0 "/dev/input/$N" && chmod 640 "/dev/input/$N" && \
            echo "btgamepad: recreated deleted input node /dev/input/$N ($MAJ:$MIN)"
    done
fi

# 3c. Rewrite the jail config -- opal only.
if [ "$MACHINE" = "opal" ] && [ -f "$JPK" ]; then
    # Establish a known-stock backup. 1.1.0 made one; if it is missing, derive
    # one by stripping every line either version could have added.
    if [ ! -f "$JPKORIG" ]; then
        sed -e '/^# >>> btgamepad begin/,/^# <<< btgamepad end/d' \
            -e '/^mkdir \/dev\/input$/d' \
            -e '/^mount ro \/dev\/input$/d' "$JPK" > "$JPKORIG"
    fi
    # Regenerate from stock every time: idempotent, and it migrates a 1.1.0
    # install by construction -- the bad "mount ro /dev/input" simply is not in
    # the stock file we build from. Strip the markers from the source too, in
    # case an older backup was itself captured from a patched file.
    sed -e '/^# >>> btgamepad begin/,/^# <<< btgamepad end/d' \
        -e '/^mkdir \/dev\/input$/d' \
        -e '/^mount ro \/dev\/input$/d' "$JPKORIG" > "/tmp/btgp-src.$$"
    awk -v blk="$SRC/jail-input-block.conf" '
        { print }
        /^mkdir \/dev$/ && !d { while ((getline l < blk) > 0) print l; d = 1 }
    ' "/tmp/btgp-src.$$" > "/tmp/btgp-jpk.$$"
    # Only install it if the splice actually produced what we expect. If it did
    # not, still install the stripped file: that loses gamepad-in-jail, but it
    # gets 1.1.0's `mount ro /dev/input` off the device, which is the part that
    # breaks games. Leaving the old config in place is the one bad outcome.
    if grep -q '^mknod /dev/input/event3 c 13 67$' "/tmp/btgp-jpk.$$"; then
        cp "/tmp/btgp-jpk.$$" "$JPK"
        echo "btgamepad: PDK jail config updated (mknod gamepad nodes, no bind mount)"
    else
        cp "/tmp/btgp-src.$$" "$JPK"
        echo "btgamepad: WARNING: could not splice $SRC/jail-input-block.conf --"
        echo "btgamepad: reverted $JPK to stock instead. PDK games will work;"
        echo "btgamepad: gamepads will not reach jailed PDK apps."
    fi
    rm -f "/tmp/btgp-src.$$" "/tmp/btgp-jpk.$$"
else
    echo "btgamepad: machine '$MACHINE' is not opal -- leaving $JPK untouched"
fi

# 4. Teach the Bluetooth settings app to CONNECT gamepads/mice over HID.
#    Stock already lists a gamepad under "Other" and types it DEVICETYPE='Gamepad'
#    -- users pair it from where it naturally appears. But three stock checks only
#    ever act on keyboards, so a paired gamepad never HID-connects:
#      (a) model connectHid() fires profconnect('hid') only if isKeyboard(cod)
#      (b) the tap handler bails for non-Audio/Phone disconnected devices
#      (c) inbound (press-the-pad's-button) reconnect auto-connects only keyboards
#    Each guard keys on a string unique to the PATCHED result.
BTROOT=/usr/palm/applications/com.palm.app.bluetoothtab/app
BTMODEL="$BTROOT/models/Bluetooth.js"
BTASSIST="$BTROOT/controllers/bluetooth-assistant.js"
if [ -f "$BTMODEL" ] && [ -f "$BTASSIST" ]; then
    [ -f "$BTMODEL.btshim-orig" ]  || cp "$BTMODEL" "$BTMODEL.btshim-orig"
    [ -f "$BTASSIST.btshim-orig" ] || cp "$BTASSIST" "$BTASSIST.btshim-orig"
    # (a) connectHid: accept gamepad/mouse -> enables auto-connect after pairing
    grep -q "isKeyboard(device.cod) || isGamepad" "$BTMODEL" || \
        sed -i 's/if( isKeyboard(device.cod)) {/if( isKeyboard(device.cod) || isGamepad(device.cod) || isMouse(device.cod)) {/' "$BTMODEL"
    # (c) inbound HID reconnect: accept gamepad/mouse (press the pad button to reconnect)
    grep -q "isGamepad(this.deviceCoD" "$BTMODEL" || \
        sed -i 's/if(isKeyboard(this.deviceCoD\[payload.address\])){/if(isKeyboard(this.deviceCoD[payload.address]) || isGamepad(this.deviceCoD[payload.address]) || isMouse(this.deviceCoD[payload.address])){/' "$BTMODEL"
    # (b) tap handler: let a disconnected Gamepad/Mouse fall through to connect
    grep -q 'DEVICETYPE != "Gamepad"' "$BTASSIST" || \
        sed -i 's/!= "Audio" \&\& device.DEVICETYPE != "Phone" \&\& /!= "Audio" \&\& device.DEVICETYPE != "Phone" \&\& device.DEVICETYPE != "Gamepad" \&\& device.DEVICETYPE != "Mouse" \&\& /' "$BTASSIST"
fi

# 5. LD_PRELOAD the shim into PmBtEngine + force sysrq off (backup once).
#    Backup lives OUTSIDE /etc/event.d -- every file there races as an upstart job.
[ -f /etc/bluetooth.upstart.btshim-orig ] || cp /etc/event.d/bluetooth /etc/bluetooth.upstart.btshim-orig
cat > /etc/event.d/bluetooth <<'JOBEOF'
description "Palm Bluetooth"

start on stopped finish

respawn
exec /bin/sh -c 'echo 0 > /proc/sys/kernel/sysrq; export LD_PRELOAD=/usr/lib/libpmbtgamepad.so; export WEBOS_BT_SHIM_LOG=/var/log/btshim.log; export WEBOS_BT_SHIM_DUMP=0; exec /usr/bin/BluetoothMonitor'
JOBEOF

echo "btgamepad: installed. Reboot to activate (upstart job change needs a reboot)."
exit 0
