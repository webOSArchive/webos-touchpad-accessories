#!/bin/sh
#
# prerm -- runs as root before the package is removed. Stops + removes the
# daemon and its upstart job. Leaves any mounted USB storage alone (the user
# may have data on it); just removes our control/state IPC files.
#
echo "usbsettings: removing device components..."

SVCID=com.webosarchive.usbsettings.service

# The daemon, launcher, and upstart job live on the root fs, which is mounted
# read-only on a stock device -- make it writable so we can remove them, then
# restore read-only at the end.
mount -o remount,rw / 2>/dev/null || true

stop usbctl-watchd 2>/dev/null && echo "  stopped usbctl-watchd" || true
killall usbdevmon 2>/dev/null || true
rm -f /usr/bin/usbctl-watchd
rm -f /usr/bin/usbctl-jsservice
rm -f /usr/bin/usbdevmon
rm -f /etc/event.d/usbctl-watchd
rm -f /media/internal/.usbctl-control /media/internal/.usbctl-status /media/internal/.usbctl-state
rm -f /media/internal/.usbctl-watch /media/internal/.usbctl-devices

# remove the JS-service registration we added in postinst
for bus in pub prv; do
    rm -f /var/palm/ls2/roles/$bus/$SVCID.json
    rm -f /var/palm/ls2/services/$bus/$SVCID.service
done

# restore the stock read-only root
mount -o remount,ro / 2>/dev/null || true

echo "usbsettings: removal complete."
exit 0
